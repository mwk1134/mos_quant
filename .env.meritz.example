# Copy to .env.meritz and fill locally. Do not commit real credentials.
MERITZ_ACCOUNT_PRESET=KMW
MERITZ_APP_KEY=
MERITZ_APP_SECRET=
# 12 hexadecimal characters, without ':' or '-'. Use the calling machine's MAC.
MERITZ_MAC_ADDRESS=
# Optional when SOXL holdings already identify the exchange.
# Enter only the SOXL exchange vendor code verified for this Meritz account.
MERITZ_SOXL_EXCHANGE_CODE=
# The API may report a zero price tick. Enter the verified SOXL order tick then.
MERITZ_SOXL_PRICE_TICK=
# Optional, for reading GitHub snapshots with authentication.
GITHUB_TOKEN=
